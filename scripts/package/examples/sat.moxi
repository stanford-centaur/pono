; A counter of 8 bits that an input either increments or leaves alone. The
; query asks whether the counter can reach 3, which it does after three
; increments, so the query is satisfiable.
(set-logic QF_BV)
(define-system main
  :input ((inc Bool))
  :output ((count (_ BitVec 8)))
  :init (= count #x00)
  :trans (= count' (ite inc (bvadd count #x01) count)))
(check-system main
  :input ((inc Bool))
  :output ((count (_ BitVec 8)))
  :reachable (three (= count #x03))
  :query (reach-three (three)))
