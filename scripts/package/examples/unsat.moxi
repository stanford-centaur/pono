; A counter of 8 bits that an input either increments or leaves alone, and
; that wraps from 3 back to 0. The query asks whether the counter can reach 4,
; which it never does, so the query is unsatisfiable.
(set-logic QF_BV)
(define-system main
  :input ((inc Bool))
  :output ((count (_ BitVec 8)))
  :init (= count #x00)
  :trans (= count' (ite inc (ite (= count #x03) #x00 (bvadd count #x01)) count)))
(check-system main
  :input ((inc Bool))
  :output ((count (_ BitVec 8)))
  :reachable (four (= count #x04))
  :query (reach-four (four)))
