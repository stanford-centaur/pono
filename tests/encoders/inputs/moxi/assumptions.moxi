; Assumptions restrict the traces a query considers, in each state or, with
; primed inputs, in each step.
(set-logic QF_LIA)

; adds its input in each step
(define-system Acc
  :input ((i Int))
  :output ((s Int))
  :init (= s 0)
  :trans (= s' (+ s i)))

(check-system Acc
  :input ((i Int))
  :output ((s Int))
  :assumption (nonneg (>= i 0))
  :reachable (negative (< s 0))
  :query (free (negative))
  :query (assumed (nonneg negative)))

; remembers its input from the step before
(define-system Pulse
  :input ((b Bool))
  :output ((q Bool))
  :init (not q)
  :trans (= q' b))

(check-system Pulse
  :input ((b Bool))
  :output ((q Bool))
  ; the input is never true in two steps in a row
  :assumption (isolated (=> b (not b')))
  :reachable (twice (and q b))
  :query (any_input (twice))
  :query (isolated_input (isolated twice)))
