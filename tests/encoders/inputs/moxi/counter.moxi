; A counter that wraps around to 0 after 5, so it never shows 6.
(set-logic QF_BV)

(define-system Counter
  :output ((c (_ BitVec 4)))
  :init (= c #x0)
  :trans (= c' (ite (= c #x5) #x0 (bvadd c #x1))))

(check-system Counter
  :output ((c (_ BitVec 4)))
  :reachable (five (= c #x5))
  :reachable (six (= c #x6))
  ; conditions over a transition, with next-state variables
  :reachable (up (and (= c #x2) (= c' #x3)))
  :reachable (skip (and (= c #x5) (= c' #x6)))
  :query (reach_five (five))
  :query (reach_six (six))
  :query (step_up (up))
  :query (step_skip (skip)))
