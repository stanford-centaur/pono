; Several check-system commands, which the index selects one of: one leaves
; out the variables, keeping the system's names, and the last has a :queries
; attribute, which is not supported but leaves the others to be checked.
(set-logic QF_BV)

(define-system Toggle
  :input ((en Bool))
  :output ((q Bool))
  :init (not q)
  :trans (= q' (xor q en)))

(check-system Toggle
  :input ((e Bool))
  :output ((o Bool))
  :reachable (on o)
  :query (turns_on (on)))

(check-system Toggle
  :input ((e Bool))
  :output ((o Bool))
  :reachable (on_without_enable (and o (not e) (not (= o true))))
  :query (impossible (on_without_enable)))

(check-system Toggle
  :reachable (stays_off (and (not q) en))
  :query (off_then_enabled (stays_off)))

(check-system Toggle
  :reachable (on q)
  :reachable (off (not q))
  :queries ((turns_on (on)) (turns_off (off))))
